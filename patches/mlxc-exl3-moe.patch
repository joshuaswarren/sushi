EXL3 routed MoE for sushi's moeSwigluClamped non-Metal route (M3b). The
pinned mlx-c @56b2d39 has no surface for the EXL3 pack: sushi's non-Metal
branch currently runs the host plainMoeFused loop. This adds the mlx-c
wrapper mlx_fast_exl3_moe forwarding to mlx::core::fast::exl3_moe (added
to omarchy-mlx by patches/mlx-fast-exl3-moe.patch): it decodes the packed
trellis banks and runs the routed clamped-SwiGLU MoE (gate upper-clamped,
up symmetrically clamped, limit == 0 disables). `window` carries sushi's
runtime codeword-window config; the C ABI has no other channel for it.

--- a/mlx/c/fast.h
+++ b/mlx/c/fast.h
@@ -99,6 +99,24 @@
     const mlx_stream s);
 
 /**
+ * EXL3 trellis tile decode: reconstruct one expert weight matrix
+ * [in_features, out_features] from its packed flat trellis plus the
+ * suh/svh scale bit patterns, bit-exact to sushi's expert_exl3.zig
+ * reconstructPublic.
+ */
+int mlx_fast_exl3_decode(
+    mlx_array* res,
+    const mlx_array trellis,
+    const mlx_array suh,
+    const mlx_array svh,
+    int in_features,
+    int out_features,
+    int bits,
+    int window,
+    mlx_dtype out_dtype,
+    const mlx_stream s);
+
+/**
  * Routed EXL3 MoE layer (sushi's moeSwigluClamped non-Metal route).
  * Decodes the packed trellis banks with the EXL3 reference decoder and
  * runs the routed clamped-SwiGLU MoE over the router slots; the gate
--- a/mlx/c/fast.cpp
+++ b/mlx/c/fast.cpp
@@ -276,6 +276,37 @@
   return 0;
 }
 
+extern "C" int mlx_fast_exl3_decode(
+    mlx_array* res,
+    const mlx_array trellis,
+    const mlx_array suh,
+    const mlx_array svh,
+    int in_features,
+    int out_features,
+    int bits,
+    int window,
+    mlx_dtype out_dtype,
+    const mlx_stream s) {
+  try {
+    mlx_array_set_(
+        *res,
+        mlx::core::fast::exl3_decode(
+            mlx_array_get_(trellis),
+            mlx_array_get_(suh),
+            mlx_array_get_(svh),
+            in_features,
+            out_features,
+            bits,
+            window,
+            mlx_dtype_to_cpp(out_dtype),
+            mlx_stream_get_(s)));
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
+
